# Nino1's key list: types, ranges, defaults, nesting. Read through
# ConfigParser, so it can carry comments and trailing commas like config.json.
#
# A mode block's "inherits" list names top-level keys it falls back to when
# config.json omits them — declaring each theme rule once, here, rather than
# restating it per mode. See architecture.md "Schema vocabulary".
{
  "type": "object",
  "fields": {
    "background": { "type": "color", "default": "#66282828" },
    "radius": { "type": "number", "default": 16, "min": 0 },
    "borderWidth": { "type": "number", "default": 2, "min": 0 },
    "accent": { "type": "color", "default": "#87af5f" },
    "text": { "type": "color", "default": "#ffcdd6f4" },
    "padding": { "type": "number", "default": 3, "min": 0 },
    "gap": { "type": "number", "default": 10, "min": 0 },
    "bold": { "type": "bool", "default": false },
    "font": { "type": "string", "default": "Departure Mono" },
    "fontSize": { "type": "number", "default": 12, "min": 1 },

    "cursorPollIntervalMs": { "type": "number", "default": 16, "min": 1 },
    "audioPollIntervalMs": { "type": "number", "default": 200, "min": 1 },

    "instances": {
      "type": "list",
      "idField": "id",
      "entry": {
        "type": "object",
        "fields": {
          "id": { "type": "string", "default": "" },
          "restingMode": { "type": "enum", "values": ["dot", "pill", "bar", "card", "dashboard"], "default": "dot" },
          "animationSet": { "type": "string", "default": "Default" },

          # Order for the cycleModes command. Omit it and every mode this
          # instance declares is cycled, in the order they appear here.
          "cycleModes": { "type": "list", "idField": "", "entry": { "type": "string", "default": "" } },

          "dot": {
            "type": "object",
            # No gap: Dot holds a single module, so there is nothing to space.
            "inherits": ["background", "radius", "borderWidth", "accent", "text", "padding", "font", "fontSize"],
            "fields": {
              "draggable": { "type": "bool", "default": false },
              "clicks": { "type": "opaque" },
              "sizing": { "type": "enum", "values": ["fixed", "screen"], "default": "fixed" },
              "contentShape": { "type": "enum", "values": ["single", "autoflow", "cardBody", "dashboardGrid"], "default": "single" },
              "positioning": { "type": "enum", "values": ["cursor", "anchored", "inherit"], "default": "cursor" },
              "angle": { "type": "number", "min": 0, "max": 360, "wrap": true, "literal": ["free"], "default": "free" },
              "targetDistance": { "type": "number", "default": 15, "min": 0 },
              "size": { "type": "number", "default": 10, "min": 0 },
              "module": { "type": "string", "default": "" },
              "moduleOptions": { "type": "opaque" }
            }
          },

          "pill": {
            "type": "object",
            "inherits": ["background", "radius", "borderWidth", "accent", "text", "padding", "gap", "font", "fontSize"],
            "fields": {
              "draggable": { "type": "bool", "default": true },
              "clicks": { "type": "opaque" },
              "sizing": { "type": "enum", "values": ["fixed", "screen"], "default": "fixed" },
              "iconSize": { "type": "number", "default": 24, "min": 1 },
              "contentShape": { "type": "enum", "values": ["single", "autoflow", "cardBody", "dashboardGrid"], "default": "autoflow" },
              "positioning": { "type": "enum", "values": ["cursor", "anchored", "inherit"], "default": "cursor" },
              "angle": { "type": "number", "min": 0, "max": 360, "wrap": true, "literal": ["free"], "default": "free" },
              "targetDistance": { "type": "number", "default": 25, "min": 0 },
              "width": { "type": "number", "default": 140, "min": 0 },
              "height": { "type": "number", "default": 30, "min": 0 },
              "deadzone": { "type": "number", "default": 60, "min": 0 },
              "delayMs": { "type": "number", "default": 0, "min": 0 },
              "speed": { "type": "number", "default": 7, "min": 0 },  # thousands of px/s
              "easeMs": { "type": "number", "default": 120, "min": 0 },
              "minMoveMs": { "type": "number", "default": 150, "min": 0 },

              "moduleAlignment": {
                "type": "object",
                "fields": {
                  "horizontal": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" },
                  "vertical": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" }
                }
              },
              "modules": {
                "type": "list",
                "idField": "id",
                "entry": {
                  "type": "object",
                  "fields": {
                    "id": { "type": "string", "default": "" },
                    "module": { "type": "string", "default": "" },
              "moduleOptions": { "type": "opaque" }
                  }
                }
              },
              "moduleOptions": {
                "type": "object",
                "fields": {},
                "additional": { "type": "opaque" }
              }
            }
          },

          "bar": {
            "type": "object",
            "inherits": ["background", "radius", "borderWidth", "accent", "text", "padding", "gap", "font", "fontSize"],
            "fields": {
              "draggable": { "type": "bool", "default": false },
              "clicks": { "type": "opaque" },
              "sizing": { "type": "enum", "values": ["fixed", "screen"], "default": "fixed" },
              "iconSize": { "type": "number", "default": 24, "min": 1 },
              "contentShape": { "type": "enum", "values": ["single", "autoflow", "cardBody", "dashboardGrid"], "default": "autoflow" },
              "positioning": { "type": "enum", "values": ["cursor", "anchored", "inherit"], "default": "anchored" },
              "screen": { "type": "string", "default": "current" },
              "edge": { "type": "enum", "values": ["top", "bottom", "left", "right"], "default": "top" },
              "edgeMargin": { "type": "number", "default": 0, "min": 0 },
              "alignment": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" },
              "width": { "type": "number", "default": 300, "min": 0 },
              "height": { "type": "number", "default": 30, "min": 0 },
              "collapsedWidth": { "type": "number", "default": 250, "min": 0 },
              "collapsedHeight": { "type": "number", "default": 30, "min": 0 },
              "revealDistance": { "type": "number", "default": 40, "min": 0 },

              "moduleAlignment": {
                "type": "object",
                "fields": {
                  "horizontal": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" },
                  "vertical": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" }
                }
              },
              "modules": {
                "type": "list",
                "idField": "id",
                "entry": {
                  "type": "object",
                  "fields": {
                    "id": { "type": "string", "default": "" },
                    "module": { "type": "string", "default": "" },
              "moduleOptions": { "type": "opaque" }
                  }
                }
              },
              "moduleOptions": {
                "type": "object",
                "fields": {},
                "additional": { "type": "opaque" }
              }
            }
          },

          "card": {
            "type": "object",
            "inherits": ["background", "radius", "borderWidth", "accent", "text", "padding", "gap", "font", "fontSize"],
            "fields": {
              "draggable": { "type": "bool", "default": true },
              "clicks": { "type": "opaque" },
              "sizing": { "type": "enum", "values": ["fixed", "screen"], "default": "fixed" },
              "iconSize": { "type": "number", "default": 24, "min": 1 },
              "contentShape": { "type": "enum", "values": ["single", "autoflow", "cardBody", "dashboardGrid"], "default": "cardBody" },
              "positioning": { "type": "enum", "values": ["cursor", "anchored", "inherit"], "default": "inherit" },
              "angle": { "type": "number", "min": 0, "max": 360, "wrap": true, "literal": ["free"], "default": "free" },
              "targetDistance": { "type": "number", "default": 40, "min": 0 },
              "collapseDistance": { "type": "number", "default": 0, "min": 0 },
              "width": { "type": "number", "default": 160, "min": 0 },
              "height": { "type": "number", "default": 230, "min": 0 },
              "deadzone": { "type": "number", "default": 60, "min": 0 },
              "delayMs": { "type": "number", "default": 0, "min": 0 },
              "speed": { "type": "number", "default": 7, "min": 0 },  # thousands of px/s
              "easeMs": { "type": "number", "default": 120, "min": 0 },
              "minMoveMs": { "type": "number", "default": 150, "min": 0 },

              "moduleAlignment": {
                "type": "object",
                "fields": {
                  "horizontal": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" },
                  "vertical": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" }
                }
              },
              "modules": {
                "type": "list",
                "idField": "id",
                "entry": {
                  "type": "object",
                  "fields": {
                    "id": { "type": "string", "default": "" },
                    "module": { "type": "string", "default": "" },
              "moduleOptions": { "type": "opaque" }
                  }
                }
              },
              "moduleOptions": {
                "type": "object",
                "fields": {},
                "additional": { "type": "opaque" }
              }
            }
          },

          "dashboard": {
            "type": "object",
            # No radius and no borderWidth: Dashboard is the screen, and a
            # screen has no corners to round or edge to draw. Its cards keep
            # both, inherited independently below.
            "inherits": ["background", "accent", "text", "padding", "gap", "font", "fontSize"],
            "fields": {
              "draggable": { "type": "bool", "default": false },
              "clicks": { "type": "opaque" },
              "sizing": { "type": "enum", "values": ["fixed", "screen"], "default": "screen" },
              "contentShape": { "type": "enum", "values": ["single", "autoflow", "cardBody", "dashboardGrid"], "default": "dashboardGrid" },
              "positioning": { "type": "enum", "values": ["cursor", "anchored", "inherit"], "default": "anchored" },
              "columns": { "type": "number", "default": 7, "min": 1 },
              "rows": { "type": "number", "default": 6, "min": 1 },

              "cards": {
                "type": "list",
                "idField": "id",
                "entry": {
                  "type": "object",
                  "inherits": ["background", "radius", "borderWidth", "accent", "text", "padding", "gap", "font", "fontSize"],
                  "fields": {
                    "id": { "type": "string", "default": "" },
                    "col": { "type": "number", "default": 0, "min": 0 },
                    "row": { "type": "number", "default": 0, "min": 0 },
                    "w": { "type": "number", "default": 1, "min": 1 },
                    "h": { "type": "number", "default": 1, "min": 1 },
                    "iconSize": { "type": "number", "default": 24, "min": 1 },

                    "moduleAlignment": {
                      "type": "object",
                      "fields": {
                        "horizontal": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" },
                        "vertical": { "type": "enum", "values": ["center", "left", "right", "top", "bottom"], "default": "center" }
                      }
                    },
                    "modules": {
                      "type": "list",
                      "idField": "id",
                      "entry": {
                        "type": "object",
                        "fields": {
                          "id": { "type": "string", "default": "" },
                          "module": { "type": "string", "default": "" },
              "moduleOptions": { "type": "opaque" }
                        }
                      }
                    },
                    "moduleOptions": {
                      "type": "object",
                      "fields": {},
                      "additional": { "type": "opaque" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
