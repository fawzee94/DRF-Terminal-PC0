
{
  # Default Theme
  "background": "#66282828",
  "radius": 16,
  "borderWidth": 1,
  "accent": "#87af5f",
  "text": "#ffcdd6f4",
  "padding": 5,
  "gap": 6,
  "bold": false,
  "font": "Departure Mono",
  "fontSize": 12,

  # System
  "cursorPollIntervalMs": 16,
  "audioPollIntervalMs": 200,

  # Instances
  "instances": [
    {
      "id": "nino1",
      "restingMode": "dot",

      # How this Nino moves. A mode overrides only what it wants different.
      "defaultAngle": "free",
      "angleDegrees": 0,
      "deadzone": 0,
      "delayMs": 0,
      "speed": 0,
      "easeMs": 20,
      "minMoveMs": 150,
      "animationSet": "Default",
      "cycleModes": ["dot","pill", "bar"],

      "dot": {
        "targetDistance": 23,
        "size":15,
        "module": null,
        "moduleOptions": {
          "timeFormat": "hh:mm",
          # A bare name is the whole command; the long form carries a value.
          "clicks": { "left": "copyDate", "right": { "command": "takeover" } }
        },

        # Inherits from the top-level theme. Override any of:
        #   background, radius, borderWidth, accent, text, padding, font, fontSize
        "radius": 16,

      },

      "pill": {
        "targetDistance": 35,
        "deadzone": 35,

        # Shrink-in-place, off until revealDistance is set. 0 on an axis means
        # it does not shrink on that one. Only a *parked* pill can show it —
        # a following one holds the cursor at targetDistance forever.
        "revealDistance": 20,
        "collapsedWidth": 70,
        "collapsedHeight": 30,

        "width": 150,
        "height": 30,

        # What a click anywhere on this mode does when the module under it
        # claims nothing. A bare name is the whole command; the long form
        # carries a value. An omitted button does nothing.
        # Commands: close, collapse, back, togglePin, toggleFollow,
        # cycleModes, and switchMode/setPinned/takeover with a value.
        "clicks": {
          "left": { "command": "switchMode", "value": "card" },
          "right": { "command": "switchMode", "value": "card" },
          "middle": "toggleFollow"
        },

        # Inherits from the top-level theme. Override any of:
        #   background, radius, borderWidth, accent, text, padding, gap, font, fontSize

        "moduleAlignment": {
          "horizontal": "center",
          "vertical": "center"
        },
        "modules": [
          { "id": "pillClock", "module": "Clock" },
          { "id": "pillVolume", "module": "Volume" },
          { "id": "pillLauncher", "module": "Launcher" }
        ],
        "moduleOptions": {
          "pillClock": {
            "view": "icon",
            "dateFormat": "ddd, MMM d",
            "timeFormat": "hh:mm",
            "clicks": {"right": { "command": "takeover", "value": "pillClock" } }
          },
          "pillVolume": {
            "view": "widget"
          },
          "pillLauncher": {
            "view": "icon",
            "clicks": { "left": { "command": "takeover", "value": "pillLauncher" } }
          }
        }
      },

      "bar": {
        "screen": "current",
        "edge": "top",
        "edgeMargin": 5,
        "alignment": "center",
        "width": 150,
        "height": 30,
        "collapsedWidth": 15,
        "collapsedHeight": 15,
        "revealDistance": 30,

        "clicks": { "left": { "command": "switchMode", "value": "card" }, "right": { "command": "switchMode", "value": "card" } },

        # Inherits from the top-level theme. Override any of:
        #   background, radius, borderWidth, accent, text, padding, gap, font, fontSize

        "moduleAlignment": {
          "horizontal": "center",
          "vertical": "center"
        },
        "modules": [
          { "id": "barClock", "module": "Clock" },
          { "id": "barVolume", "module": "Volume" }
        ],
        "moduleOptions": {
          "barClock": {
            "view": "widget",
            "dateFormat": "ddd, MMM d",
            "timeFormat": "hh:mm",
            "clicks": {"right": { "command": "takeover", "value": "barClock" } }
          },
          "barVolume": {
            "view": "widget"
          }
        }
      },

      "card": {
        "targetDistance": 40,
        "collapseDistance": 40,
        "width": 160,
        "height": 200,
        "deadzone": 40,
        "delayMs": 10,
        "speed": 3,

        "clicks": {
          "right": "close",
          "middle": "toggleFollow"
        },

        # Inherits from the top-level theme. Override any of:
        #   background, radius, borderWidth, accent, text, padding, gap, font, fontSize
        "padding": 15,

        "moduleAlignment": {
          "horizontal": "left"
        },
        "modules": [
          { "id": "cardControls", "module": "ControlBar" },
          { "id": "cardClock", "module": "Clock" },
          { "id": "cardVolume", "module": "Volume" },
          { "id": "cardsClock", "module": "Clock" },
          { "id": "cardsVolume", "module": "Volume" },
          { "id": "cardClock2", "module": "Clock" }
        ],
        "moduleOptions": {
          "cardControls": { "buttons": ["pin", "dashboard", "back", "close"] },
          "cardClock": { "view": "widget", "clicks": {"right": { "command": "takeover", "value": "cardClock" }} },
          "cardVolume": { "view": "widget" },
          "cardsClock": { "view": "icon" },
          "cardsVolume": { "view": "icon", "clicks": {"right": { "command": "takeover", "value": "cardsVolume" }} },
          "cardClock2": { "view": "takeover" }
        }
      },

      "dashboard": {
        "columns": 7,
        "rows": 5,
        "padding": 50,

        "clicks": { "middle": "back" },
        

        "cards": [
          {
            "id": "card1",
            "col": 3,
            "row": 0,
            "w": 1,
            "h": 1,
            "iconSize": 24,

            # Inherits from the top-level theme. Override any of:
            #   background, radius, borderWidth, accent, text, padding, gap, font, fontSize

            "moduleAlignment": {
              "horizontal": "center"
            },
            "modules": [
              { "id": "card1Clock", "module": "Clock" },
              { "id": "card1Volume", "module": "Volume" }
            ],
            "moduleOptions": {"card1Clock": { "view": "takeover" }, "card1Volume": { "view": "widget" }}
          },
          {
            "id": "card2",
            "col": 2,
            "row": 0,
            "w": 1,
            "h": 1,
            "iconSize": 24,

            # Inherits from the top-level theme. Override any of:
            #   background, radius, borderWidth, accent, text, padding, gap, font, fontSize

            "moduleAlignment": {
              "horizontal": "center"
            },
            "modules": [
              { "id": "card2Clock", "module": "Clock" }
            ],
            "moduleOptions": {"card2Clock": { "view": "takeover" }}
          }
        ]
      }
    }
  ]
}
