/*
╒ ▸ 𜶋 𜵧 ═╾
╘══════╡𜵧 🭊 ▟▛ 𜵏 𜵧 ∃ 𜵏 ◀ 𜵥𜶤:

	ᕌ ᔵ ᘍ ᘍ ᒭ ᘍ ᔵ
	
	ᒵ ᔖ ᘎ ∏ ᑢ
	ᐳ ~/.config/fastfetch/config.jsonc
╼═╡ᖷ ᗐ ᔭ╞══════════════════════════════════╛
*/
{
	"$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	
/*
╒╡ᒶ ᘎ ᕌ ᘎ╞┅ᐧ
╰────────────────────────────────────────────────────────────────────────╮*/
	"logo": {
		"source"	:"~/dotfiles/assets/drf/drfascii.txt",
		"color"		:{ "1":"38;2;135;175;95" },
		"padding": {
			"top"	:1,
			"left"	:1,
			}
		},
/*	╰────────────────────────────────────────────────────────────────╯*/
/*
╒╡ᕥ ᐞ ᔖ ᑶ ᒶ ᐐ ⋋╞┅ᐧ
╰────────────────────────────────────────────────────────────────────────╮*/
	"display": {
		"color": {
			"keys"		:"38;2;135;175;95",
			"output"	:"38;2;238;238;238"
			}
		},
/*	╰────────────────────────────────────────────────────────────────╯*/
/*
╒╡ᗑ ᘎ ᕥ ⊔ ᒶ ᘍ ᔖ╞┅ᐧ
╰────────────────────────────────────────────────────────────────────────╮*/
	"modules": [
		"host",
		"os",
		"kernel",
		"uptime",
		"packages",
		"shell",
		"wm",
		{
			"type"		:"colors",
       			"symbol"	:"circle",
        		 },
        	"break"
		]
/*	╰────────────────────────────────────────────────────────────────╯*/
}
