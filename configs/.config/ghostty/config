#╼═╡ᖷ ᗐ ᔭ╞══════════════════════════╛

#╒╡ᕌ ᘍ ᖽ ᘍ ᔸ ᐐ ᘂ╞┅ᐧ
#╰───────────────────────────────────────────────────────────────────────╮
	cursor-style			=bar
	window-inherit-font-size	=true
#	╰────────────────────────────────────────────────────────────────╯

#╒╡ᒭ ᕼ ᘍ ᗑ ᘍ╞┅ᐧ
#╰───────────────────────────────────────────────────────────────────────╮
	theme			=/home/fwz/dotfiles/assets/themes/ghostty_fwz
	font-family		="DepartureMono Nerd Font Mono"
	background-opacity	=1
	window-decoration	=none
	window-show-tab-bar	=never
	window-padding-x	=10
	window-padding-y	=10
#	╰────────────────────────────────────────────────────────────────╯

#╒╡ᖼ ᘍ ⋋ ᗱ ᐞ ∏ ᕥ ᔖ╞┅ᐧ
#╰───────────────────────────────────────────────────────────────────────╮
	keybind = ctrl+r=reload_config
	keybind = ctrl+q=close_surface
	
	keybind	= performable:ctrl+c=copy_to_clipboard
	keybind	= performable:ctrl+v=paste_from_clipboard
	
	keybind = ctrl+space=toggle_tab_overview
	keybind = ctrl+enter=new_tab
	
	keybind = alt+enter=new_split:auto
	
	keybind = alt+up=goto_split:up
	keybind = alt+down=goto_split:down
	keybind = alt+left=goto_split:left
	keybind = alt+right=goto_split:right
	
	keybind = ctrl+up=resize_split:up,10
	keybind = ctrl+down=resize_split:down,10
	keybind = ctrl+left=resize_split:left,10
	keybind = ctrl+right=resize_split:right,10

#	╰────────────────────────────────────────────────────────────────╯
